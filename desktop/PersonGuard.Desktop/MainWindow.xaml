<Window x:Class="PersonGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PersonGuard.Desktop.Models"
        xmlns:ui="clr-namespace:PersonGuard.Desktop.Presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PersonGuard" Icon="{StaticResource BrandIcon}" Width="1260" Height="820" MinWidth="980" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource AppFont}" FontWeight="Normal"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing"
        StateChanged="Window_StateChanged" Deactivated="Window_Deactivated" PreviewMouseDown="ActivityDetected" PreviewKeyDown="ActivityDetected">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="24" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <models:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVisibility" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8CA7FF" /><Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="29" /><Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Resources>

  <Border x:Name="WindowFrame" BorderBrush="#283246" BorderThickness="1" CornerRadius="12" Background="{StaticResource Bg}">
    <Grid x:Name="WindowContent" SizeChanged="WindowContent_SizeChanged">
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#090D15" BorderBrush="#202839" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <Image Source="{StaticResource BrandLogo}" Width="28" Height="28" Margin="0,0,10,0" AutomationProperties.Name="Логотип PersonGuard" />
            <TextBlock Text="PersonGuard" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0" Content="—" Click="Minimize_Click" ToolTip="Свернуть" AutomationProperties.Name="Свернуть окно" />
            <Button Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0" Content="□" Click="Maximize_Click" ToolTip="Размер окна" AutomationProperties.Name="Развернуть или восстановить окно" />
            <Button Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0" Content="×" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть приложение" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid x:Name="WelcomeView" Background="{StaticResource Bg}" ui:Motion.Entrance="True">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*" MinWidth="380"/></Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Margin="56,42,36,48">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Cyan}" Margin="0,0,8,0"/><TextBlock Text="ВАШЕ ЛИЧНОЕ ПРОСТРАНСТВО" Style="{StaticResource Eyebrow}" /></StackPanel>
            <Grid Grid.Row="1">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                <Grid Width="156" Height="156" HorizontalAlignment="Left" Margin="0,0,0,28" IsHitTestVisible="False">
                  <Ellipse Stroke="#31477E" StrokeThickness="1" Margin="2"/>
                  <Ellipse Stroke="#25375D" StrokeThickness="1" Margin="18" StrokeDashArray="2 6"/>
                  <Path Data="M 78,28 L 116,43 L 116,77 C 116,102 99,118 78,130 C 57,118 40,102 40,77 L 40,43 Z" Fill="#172A58" Stroke="#8CA7FF" StrokeThickness="1.5"/>
                  <Path Data="M 62,77 L 74,89 L 96,65" Stroke="#C8D6FF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="47" FontWeight="Bold" LineHeight="58"><Run Text="Спокойствие."/><LineBreak/><Run Text="Под вашим"/><LineBreak/><Run Text="контролем." Foreground="{StaticResource Blue}"/></TextBlock>
                <TextBlock Text="Пароли, аккаунты и всё важное — в личном зашифрованном сейфе на вашем устройстве." FontWeight="Light" Foreground="{StaticResource Muted}" FontSize="15" TextWrapping="Wrap" LineHeight="26" MaxWidth="440" Margin="0,20,0,0" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal">
              <TextBlock Text="ARGON2ID · 128 MiB" Foreground="#8E9CB4" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="  •  " Foreground="#344054"/><TextBlock Text="AES‑256‑GCM" Foreground="#8E9CB4" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="  •  " Foreground="#344054"/><TextBlock Text="WINDOWS DPAPI" Foreground="#8E9CB4" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="36">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="ДОБРО ПОЖАЛОВАТЬ В PERSONGUARD" Style="{StaticResource Eyebrow}" />
              <TextBlock Text="Ваш сейф. Ваш ключ." Style="{StaticResource PageTitle}" FontSize="29" Margin="0,12,0,12" />
              <TextBlock Text="Создайте новое хранилище или вернитесь к своим записям." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,28" />
              <Button Style="{StaticResource PrimaryButton}" Height="68" HorizontalContentAlignment="Left" Click="CreateVault_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="#07112B" FontSize="21" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Создать хранилище" Foreground="#07112B" FontWeight="Bold"/><TextBlock Text="Первый шаг к порядку в паролях" Foreground="#101E50" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel>
              </Button>
              <Button Style="{StaticResource GhostButton}" Height="68" HorizontalContentAlignment="Left" Margin="0,11,0,0" Click="OpenVault_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="↗" FontSize="19" Margin="0,0,15,0"/><StackPanel><TextBlock Text="Открыть .pgd" FontWeight="Bold"/><TextBlock Text="Вернуться к сохранённым записям" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel>
              </Button>
              <Button Style="{StaticResource GhostButton}" Height="52" Margin="0,11,0,0" Content="Открыть ключом входа" Click="OpenVaultWithPasskey_Click" />
              <Border Style="{StaticResource Card}" Margin="0,28,0,0" Background="#131E32" BorderBrush="#2F426C">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◇" Foreground="{StaticResource Cyan}" FontSize="21"/><StackPanel Grid.Column="1"><TextBlock Text="Только у вас есть ключ" FontWeight="SemiBold"/><TextBlock Text="Сохраните мастер-пароль и резервную копию отдельно. Серверного восстановления нет." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/></StackPanel></Grid>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="VaultView" Visibility="Collapsed" ui:Motion.Entrance="True">
          <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#0B0F18" BorderBrush="#202839" BorderThickness="0,0,1,0">
            <Grid Margin="14,16">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,15">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="8" Background="#182544"><TextBlock Text="◇" Foreground="#8CA7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="ТЕКУЩИЙ СЕЙФ" Foreground="#8E9CB4" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="VaultNameText" Text="Мои пароли" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1">
                <Button x:Name="VaultNavButton" Style="{StaticResource NavButton}" Background="#182544" Foreground="White" Content="▦     Хранилище" Click="ShowVaultPage_Click" />
                <Button x:Name="GraphNavButton" Style="{StaticResource NavButton}" Content="⌘     Схема связей" Click="ShowGraphPage_Click" />
                <Button x:Name="SecurityNavButton" Style="{StaticResource NavButton}" Content="⬡     Безопасность" Click="ShowSecurityPage_Click" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="ГРУППЫ ПО EMAIL" Foreground="#8E9CB4" FontSize="11" FontWeight="Bold" Margin="12,28,0,10" />
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:EmailGroup}">
                      <Button Style="{StaticResource NavButton}" HorizontalContentAlignment="Left" Tag="{Binding Email}" Click="Group_Click" ToolTip="{Binding Email}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                          <Border Width="24" Height="24" CornerRadius="6" Background="#344C82"><TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <TextBlock Grid.Column="1" Text="{Binding Email}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13" Margin="8,0"/>
                          <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#9AA8BF" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Grid.Row="4">
                <Border BorderBrush="#203047" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>
                <TextBlock Text="◇   Личный сейф" Foreground="#43C493" FontSize="11" Margin="12,0,0,6"/>
                <TextBlock Text="ВАШИ ДАННЫЕ НА УСТРОЙСТВЕ" Foreground="#8E9CB4" FontSize="11" FontWeight="Bold" Margin="12,0,0,10"/>
                <Button Style="{StaticResource NavButton}" Content="⌾     Заблокировать сейф" Click="LockVault_Click" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition x:Name="ContentHeaderRow" Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="ContentHeaderBorder" Grid.Row="0" BorderBrush="#202839" BorderThickness="0,0,0,1" Background="#0B0F18">
              <Grid Margin="28,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="BreadcrumbText" Text="PERSONGUARD / ХРАНИЛИЩЕ" Style="{StaticResource Eyebrow}" FontSize="11"/><TextBlock x:Name="PageTitleText" Text="Все записи" Style="{StaticResource PageTitle}" FontSize="29" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource GhostButton}" Content="↓  Сохранить" Margin="9,0,0,0" Click="SaveVault_Click" />
                  <Button x:Name="AddEntryButton" Style="{StaticResource PrimaryButton}" Content="＋  Добавить запись" Margin="9,0,0,0" Click="AddEntry_Click" />
                </StackPanel>
                <Grid x:Name="SearchRegion" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                  <TextBox x:Name="SearchBox" Height="46" Padding="40,0,14,0" MaxLength="600" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по сайтам и логинам" AutomationProperties.Name="Поиск по сайтам и логинам"/>
                  <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.5" Data="M 12,7 A 5,5 0 1 1 2,7 A 5,5 0 1 1 12,7 M 11,11 L 16,16" IsHitTestVisible="False"/>
                  <TextBlock x:Name="SearchPlaceholder" Text="Найти сайт или аккаунт" FontSize="15" Foreground="{StaticResource Muted}" Margin="41,0,14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding Visibility, ElementName=SearchBox}" Value="Visible"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Row="1" Background="#0B0F18" BorderBrush="#202839" BorderThickness="0,0,0,1">
              <Grid Margin="34,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#57D69A" Margin="0,0,7,0"/><TextBlock Text="Сейф открыт" Foreground="#9AA8BF" FontSize="12"/><TextBlock x:Name="DirtyText" Text="Все изменения сохранены" Foreground="#8E9CB4" FontSize="12" Margin="16,0,0,0"/></StackPanel><TextBlock x:Name="FeedbackText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Cyan}" FontSize="12"/><TextBlock x:Name="FilePathText" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8E9CB4" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420"/></Grid>
            </Border>

            <Grid Grid.Row="2">
              <ScrollViewer x:Name="EntriesPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ui:Motion.Entrance="True">
                <StackPanel Margin="28,24,28,36">
                  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="ВСЕ ЗАПИСИ" Foreground="#9AA8BF" FontSize="11" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="TotalMetric" Text="00" FontSize="28" FontWeight="Bold"/><TextBlock Text="  в этом сейфе" Foreground="#8E9CB4" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0"><StackPanel><TextBlock Text="ГРУППЫ EMAIL" Foreground="#9AA8BF" FontSize="11" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="GroupsMetric" Text="00" FontSize="28" FontWeight="Bold"/><TextBlock Text="  связанных профилей" Foreground="#8E9CB4" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="НАДЁЖНОСТЬ" Foreground="#9AA8BF" FontSize="11" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock x:Name="HealthMetric" Text="—" FontSize="28" FontWeight="Bold"/><TextBlock Text="  сильных паролей" Foreground="#8E9CB4" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel></StackPanel></Border>
                  </Grid>
                  <Border x:Name="PasswordAlertsPanel" Style="{StaticResource Card}" Visibility="Collapsed" Background="#2C2A21" BorderBrush="#65583B" Margin="0,0,0,16">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="10" Background="#51442C" VerticalAlignment="Top"><TextBlock Text="!" Foreground="#F0C779" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="2,0,18,0">
                        <TextBlock Text="ЕСТЬ ПОВТОРЯЮЩИЕСЯ ПАРОЛИ" Foreground="#F0C779" FontSize="12" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="PasswordAlertsList" Margin="0,7,0,0">
                          <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:PasswordReuseAlert}"><Border Background="{Binding RiskBackground}" BorderBrush="{Binding RiskAccent}" BorderThickness="1,0,0,0" Padding="9,5" Margin="0,0,0,5"><TextBlock Text="{Binding Message}" Foreground="{Binding RiskAccent}" TextWrapping="Wrap" LineHeight="19"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="12,8" Content="Показать записи" Tag="weak" Click="Filter_Click" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <Grid Margin="0,0,0,15"><TextBlock x:Name="ResultText" Text="0 записей" Foreground="#9AA8BF" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AllFilterButton" Style="{StaticResource GhostButton}" Padding="11,7" Content="Все" Tag="all" Click="Filter_Click"/><Button x:Name="FavoriteFilterButton" Style="{StaticResource GhostButton}" Padding="11,7" Content="Избранные" Tag="favorite" Margin="6,0,0,0" Click="Filter_Click"/><Button x:Name="WeakFilterButton" Style="{StaticResource GhostButton}" Padding="11,7" Content="Требуют внимания" Tag="weak" Margin="6,0,0,0" Click="Filter_Click"/></StackPanel></Grid>
                  <Border x:Name="EmptyState" Style="{StaticResource Card}" MinHeight="240" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="54" Height="54" CornerRadius="14" Background="#182544"><TextBlock Text="◇" Foreground="{StaticResource Cyan}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitleText" Text="Здесь начинается порядок" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,7"/><TextBlock x:Name="EmptyDescriptionText" Text="Добавьте первую запись в свой личный сейф." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/><Button x:Name="EmptyActionButton" Style="{StaticResource PrimaryButton}" Content="Добавить первую запись" HorizontalAlignment="Center" Margin="0,18,0,0" Click="AddEntry_Click"/></StackPanel>
                  </Border>
                  <Grid x:Name="EntryPager" Margin="0,0,12,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageRangeText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="13"/>
                    <Button x:Name="PreviousEntriesButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="← Назад" Padding="12,7" Click="PreviousEntries_Click" AutomationProperties.Name="Предыдущая страница записей"/>
                    <Button x:Name="NextEntriesButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Далее →" Padding="12,7" Margin="8,0,0,0" Click="NextEntries_Click" AutomationProperties.Name="Следующая страница записей"/>
                  </Grid>
                  <ItemsControl x:Name="EntriesList" SizeChanged="EntriesList_SizeChanged">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding EntryColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type models:VaultEntry}">
                        <Border Style="{StaticResource Card}" MinHeight="215" Margin="0,0,12,12" ui:Motion.Hover="True">
                          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <Border Width="38" Height="38" CornerRadius="9" Background="{Binding RiskBackground}" BorderBrush="{Binding SecurityAccent}" BorderThickness="1.5"><TextBlock Text="{Binding SiteInitials}" Foreground="{Binding SecurityAccent}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                              <StackPanel Grid.Column="1" Margin="10,0,6,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><Button x:Name="SiteLink" Style="{StaticResource LinkButton}" Content="{Binding Host}" Tag="{Binding}" IsEnabled="{Binding HasUrl}" Click="OpenEntryUrl_Click" Margin="-1,2,0,0" ToolTip="Открыть сайт в браузере" AutomationProperties.Name="{Binding Host}"/></StackPanel>
                              <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Width="28" Background="Transparent" BorderThickness="0" Content="{Binding FavoriteGlyph}" Tag="{Binding}" Click="Favorite_Click" ToolTip="Избранное" AutomationProperties.Name="Переключить избранное"/><Button Style="{StaticResource IconButton}" Width="28" Background="Transparent" BorderThickness="0" Content="•••" Tag="{Binding}" Click="EditEntry_Click" ToolTip="Изменить запись" AutomationProperties.Name="Изменить запись"/></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                              <Grid Margin="0,0,0,10"><TextBlock Text="{Binding Username}" Margin="0,0,36,0" Foreground="#BCC8DD" TextTrimming="CharacterEllipsis"/><Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="30" Height="28" Content="▣" Tag="{Binding}" Click="CopyUsername_Click" ToolTip="Скопировать логин" AutomationProperties.Name="Скопировать логин"/></Grid>
                              <Grid><TextBlock Text="{Binding SignInSummary}" Margin="0,0,68,0" Foreground="#9AA8BF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding UsesPassword, Converter={StaticResource BooleanToVisibility}}"><Button Style="{StaticResource IconButton}" Width="30" Height="28" Content="◉" Tag="{Binding}" Click="RevealPassword_Click" ToolTip="Показать пароль на 7 секунд" AutomationProperties.Name="Показать пароль на 7 секунд"/><Button Style="{StaticResource IconButton}" Width="30" Height="28" Content="▣" Tag="{Binding}" Click="CopyPassword_Click" ToolTip="Скопировать пароль" AutomationProperties.Name="Скопировать пароль"/></StackPanel></Grid>
                              <Grid Margin="0,10,0,0" Visibility="{Binding Phone, Converter={StaticResource NonEmptyToVisibility}}"><TextBlock Text="{Binding Phone}" Margin="0,0,36,0" Foreground="#9AA8BF" TextTrimming="CharacterEllipsis"/><Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="30" Height="28" Content="▣" Tag="{Binding}" Click="CopyPhone_Click" ToolTip="Скопировать телефон" AutomationProperties.Name="Скопировать телефон"/></Grid>
                              <Border Margin="0,11,0,0" Padding="9,7" CornerRadius="7" Background="{Binding RiskBackground}" BorderBrush="{Binding SecurityAccent}" BorderThickness="1" Visibility="{Binding HasReusedPassword, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding PasswordReuseWarning}" Foreground="{Binding SecurityAccent}" FontSize="11" TextWrapping="Wrap" LineHeight="19"/></Border>
                            </StackPanel>
                            <StackPanel x:Name="EntryFooter" Grid.Row="2" Margin="0,15,0,0">
                              <Border x:Name="EntryGroupBadge" Background="#16213A" CornerRadius="5" Padding="7,4" HorizontalAlignment="Left" MaxWidth="190"><TextBlock Text="{Binding EmailGroup}" Foreground="#9DAFE3" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding EmailGroup}"/></Border>
                              <TextBlock x:Name="EntryRiskLabel" Text="{Binding StrengthLabel}" Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{Binding SecurityAccent}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <Grid x:Name="GraphPage" Visibility="Collapsed" Margin="28,24,28,36" ui:Motion.Entrance="True">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="КАРТА УЧЁТНЫХ ЗАПИСЕЙ" Style="{StaticResource Eyebrow}"/><TextBlock Text="Схема‑паутина" Style="{StaticResource PageTitle}" Margin="0,8,0,5"/><TextBlock Text="Цвет записи показывает число совпадений, цвет группы — средний риск внутри неё." Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Ellipse Width="8" Height="8" Fill="#57D69A"/><TextBlock Text="  Всё хорошо     " Foreground="{StaticResource Muted}" FontSize="12"/><Ellipse Width="8" Height="8" Fill="#E3C557"/><TextBlock Text="  2     " Foreground="{StaticResource Muted}" FontSize="12"/><Ellipse Width="8" Height="8" Fill="#F39A4B"/><TextBlock Text="  3     " Foreground="{StaticResource Muted}" FontSize="12"/><Ellipse Width="8" Height="8" Fill="#FF5C72"/><TextBlock Text="  4+ совпадения" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Background="#0C121C" ClipToBounds="True">
                  <Grid x:Name="GraphViewport" Background="Transparent" Cursor="SizeAll" ClipToBounds="True" SizeChanged="GraphCanvas_SizeChanged" MouseWheel="GraphViewport_MouseWheel" MouseLeftButtonDown="GraphViewport_MouseLeftButtonDown" MouseMove="GraphViewport_MouseMove" MouseLeftButtonUp="GraphViewport_MouseLeftButtonUp" LostMouseCapture="GraphViewport_LostMouseCapture">
                    <Canvas x:Name="GraphCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#0C121C" UseLayoutRounding="True" SnapsToDevicePixels="True">
                      <Canvas.RenderTransform><MatrixTransform x:Name="GraphTransform"/></Canvas.RenderTransform>
                    </Canvas>
                    <StackPanel x:Name="GraphEmpty" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⌘" Foreground="#6680BC" FontSize="33" HorizontalAlignment="Center"/><TextBlock Text="Связи появятся здесь" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Добавьте записи с email или телефоном" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15" Background="#D9121925" CornerRadius="9" Padding="10,7" IsHitTestVisible="False"><TextBlock Text="ЛКМ + движение — обзор  ·  Колесо — масштаб  ·  Двойной клик — вписать" Foreground="#71809A" FontSize="11"/></Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15"><Button Style="{StaticResource GhostButton}" Padding="11,7" Content="Вписать" Click="GraphFit_Click"/><Button Style="{StaticResource IconButton}" Content="−" Margin="7,0,0,0" Click="GraphMinus_Click"/><TextBlock x:Name="GraphZoomText" Text="100%" VerticalAlignment="Center" Margin="11,0" Foreground="{StaticResource Muted}" FontSize="12"/><Button Style="{StaticResource IconButton}" Content="＋" Click="GraphPlus_Click"/></StackPanel>
                  </Grid>
                </Border>
              </Grid>

              <ScrollViewer ui:Motion.Entrance="True" x:Name="SecurityPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28,24,28,36" MaxWidth="940" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/></Style></Grid.Resources>
                  <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0"><TextBlock Text="ВАШ СПОКОЙНЫЙ КОНТРОЛЬ" Style="{StaticResource Eyebrow}"/><TextBlock Text="Защита, которой вы управляете" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Выберите, как открывать сейф и когда скрывать ваши данные." Foreground="{StaticResource Muted}" FontSize="14" LineHeight="21"/></StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Background="#131E32" Padding="16" VerticalAlignment="Top"><StackPanel><TextBlock Text="ПОДПИСЬ ПРИЛОЖЕНИЯ" Foreground="{StaticResource Cyan}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="SignatureStatusText" Text="Проверка…" Foreground="{StaticResource Muted}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                  </Grid>
                  <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="#182544"><TextBlock Text="⌾" Foreground="#8CA7FF" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Пароль приложения" FontWeight="SemiBold"/><TextBlock x:Name="AppPasswordStatus" Text="Не настроен" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Настроить" Click="ConfigureAppPassword_Click"/></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="10" Background="#182544"><TextBlock Text="◈" Foreground="#8CA7FF" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Windows Hello" FontWeight="SemiBold"/><TextBlock x:Name="HelloStatusText" Text="Проверка доступности…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button x:Name="HelloButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Включить" Click="ToggleHello_Click"/></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Ключ входа · iCloud и другие провайдеры" FontWeight="SemiBold"/><TextBlock x:Name="PasskeyStatusText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button x:Name="PasskeyButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Подключить" Click="TogglePasskey_Click"/></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Защита окна от захвата" FontWeight="SemiBold"/><TextBlock Text="Скрывать окно от стандартных API записи экрана." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="CaptureProtectionCheck" Grid.Column="1" Content="Включена" Click="SecuritySettingChanged"/></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Режим без буфера обмена" FontWeight="SemiBold"/><TextBlock Text="Скопированные данные удаляются через 20 секунд." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="ClipboardCheck" Grid.Column="1" Content="Разрешить копирование" ToolTip="Очищать скопированное через 20 секунд" Click="SecuritySettingChanged"/></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Блокировка при потере фокуса" FontWeight="SemiBold"/><TextBlock Text="Закрывать сейф при переключении на другое окно." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="FocusLockCheck" Grid.Column="1" Content="Строгий режим" Click="SecuritySettingChanged"/></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Автоблокировка" FontWeight="SemiBold"/><TextBlock Text="Очистить расшифрованный сейф после бездействия." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><ComboBox x:Name="AutoLockCombo" Grid.Column="1" Width="135" SelectionChanged="AutoLockCombo_SelectionChanged"><ComboBoxItem Tag="1">1 минута</ComboBoxItem><ComboBoxItem Tag="3">3 минуты</ComboBoxItem><ComboBoxItem Tag="5">5 минут</ComboBoxItem><ComboBoxItem Tag="15">15 минут</ComboBoxItem><ComboBoxItem Tag="0">Выключена</ComboBoxItem></ComboBox></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Повторное подтверждение" FontWeight="SemiBold"/><TextBlock Text="Сколько показывать и копировать пароли без нового запроса Windows Hello, ключа или пароля." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><ComboBox x:Name="ConfirmCombo" Grid.Column="1" Width="135" SelectionChanged="ConfirmCombo_SelectionChanged"><ComboBoxItem Tag="0">Каждый раз</ComboBoxItem><ComboBoxItem Tag="1">1 минута</ComboBoxItem><ComboBoxItem Tag="5">5 минут</ComboBoxItem><ComboBoxItem Tag="15">15 минут</ComboBoxItem></ComboBox></Grid></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Мастер‑пароль файла" FontWeight="SemiBold"/><TextBlock Text="Установить новый пароль для открытия этого сейфа." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Изменить" Click="ChangeMasterPassword_Click"/></Grid></Border>
                    <Border Style="{StaticResource Card}" Background="#0E1920"><TextBlock Text="Повторная авторизация перед показом и копированием секретов включена всегда. Отключить её нельзя." Foreground="#6FC6A2" TextWrapping="Wrap"/></Border>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>

        <Grid x:Name="AppLockedView" Visibility="Collapsed" Background="{StaticResource Bg}">
          <Border Width="440" Style="{StaticResource Card}" Padding="34" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
              <Border Width="78" Height="88" CornerRadius="22" Background="#182544" HorizontalAlignment="Center">
                <TextBlock Text="⬡" Foreground="#8CA7FF" FontSize="37" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="ЛОКАЛЬНАЯ ЗАЩИТА" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" Margin="0,25,0,0" />
              <TextBlock Text="PersonGuard заблокирован" Style="{StaticResource PageTitle}" FontSize="25" HorizontalAlignment="Center" Margin="0,9,0,7" />
              <TextBlock Text="Подтвердите пароль приложения и Windows Hello, чтобы продолжить." Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" />
              <Button Style="{StaticResource PrimaryButton}" Content="Разблокировать" Margin="0,24,0,0" Click="UnlockApp_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
